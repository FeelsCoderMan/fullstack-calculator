{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-verified-commit.sh",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking commit is verified..."
          }
        ]
      }
    ]
  }
}
