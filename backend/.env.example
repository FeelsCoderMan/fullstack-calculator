# Backend configuration. Copy to .env and adjust:  cp .env.example .env
# Every variable is REQUIRED: the server has no defaults and refuses to start
# if one is missing or empty. docker compose loads backend/.env into the
# backend container (and fails if the file is missing); `make run`/`make dev`
# load it too.

# Listen port inside the container. Compose publishes container port 8080, so
# keep 8080 when running with Docker.
PORT=8080

# Graceful shutdown drain window (Go duration, > 0). Keep it below the compose
# stop_grace_period (15s).
SHUTDOWN_TIMEOUT=10s

# debug | info | warn | error (slog offsets such as info+2 are also accepted).
LOG_LEVEL=info

# Development only: also write logs to per-category files in LOG_DIR.
# Keep false in Docker; containers log to stdout and the filesystem is read-only.
LOG_TO_FILE=false
LOG_DIR=logs
